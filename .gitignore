# Virtualenvs. The glob matters: `dfc-env/` did not match `dfc-env-311/`, and
# 8,086 files of a Python 3.11 venv were committed before anyone noticed.
dfc-env*/
.venv*/
venv*/
env/
*.egg-info/
pyvenv.cfg

# Secrets. Nothing here has ever held one, and it stays that way.
.env
.env.*
*.token
credentials.json

# The Scale SWE-Bench Pro clone carries its own git history and submodules.
SWE-bench_Pro-os/

# Harness output
logs/
dfc_swebench_run/
runs/
*.dfc-canonical.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Notebook cruft
.ipynb_checkpoints/
*.ipynb.b64

# macOS
.DS_Store

# Result artefacts: published separately, not in the repo (see README)
command_census.csv
dfc-sonnet5.*.json

# Retired run artefacts parked under outdated/ (same rule as runs/)
outdated/runs-abandoned/
outdated/_to_delete/
